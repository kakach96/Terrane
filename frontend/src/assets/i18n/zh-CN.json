    },
    "ogcTiles": {
      "fullName": "OGC API 瓦片",
      "description": "以 RESTful 方式提供瓦片矩阵集与瓦片访问（tileMatrixSets / collections / tiles）。"
    },
    "ogcMaps": {
      "fullName": "OGC API 地图",
      "description": "以 RESTful 方式提供地图渲染与样式（collections / styles / map）。"
    },
    "ogcProcesses": {
      "fullName": "OGC API 处理",
      "description": "以 RESTful 方式提交并跟踪异步处理任务（processes / jobs）。"
    },
