    "tileRest": {
      "name": "Tile REST",
      "fullName": "Generic raster tiles",
      "description": "Generic raster tile endpoint backed by the local tile cache, serving as the foundation for other tile services."
    },
    "group": {
      "ogc": "OGC Standard Services",
      "ogcapi": "OGC API Services",
      "tile": "Tiles & Cache"
    },
    "wms": {
      "fullName": "Web Map Service",
      "description": "Renders map layers as images, supports feature queries and legend output, and can generate interactive OpenLayers previews."
    },
    "wmts": {
      "fullName": "Web Map Tile Service",
      "description": "Splits maps into a tile matrix, supports both KVP and RESTful tile templates (including a local tile cache)."
    },
    "wfs": {
      "fullName": "Web Feature Service",
      "description": "Provides vector feature querying and download as GML / GeoJSON, supporting GET and POST requests."
    },
    "wcs": {
      "fullName": "Web Coverage Service",
      "description": "Publishes and retrieves raster coverage data (GeoTIFF, etc.), with tiling and reprojection support."
    },
    "wps": {
      "fullName": "Web Processing Service",
      "description": "Built-in pure Rust processing engine supporting raster tiling / slope / reclassify and other built-in processes."
    },
    "csw": {
      "fullName": "Catalog Service for the Web",
      "description": "Discovery and retrieval of geospatial metadata catalogs, supporting GET and POST requests."
    },
    "ows": {
      "fullName": "Unified OGC dispatch endpoint",
      "description": "Unified dispatch endpoint mirroring GeoServer /ows, routing to each OGC service by the service parameter."
    },
    "ogcFeatures": {
      "fullName": "OGC API Features",
      "description": "RESTful feature collection listing and feature queries (landing / conformance / collections / items)."
    },
    "ogcTiles": {
      "fullName": "OGC API Tiles",
      "description": "RESTful tile matrix sets and tile access (tileMatrixSets / collections / tiles)."
    },
    "ogcMaps": {
      "fullName": "OGC API Maps",
      "description": "RESTful map rendering and styles (collections / styles / map)."
    },
    "ogcProcesses": {
      "fullName": "OGC API Processes",
      "description": "RESTful submission and tracking of asynchronous processing jobs (processes / jobs)."
    },
    "tms": {
      "fullName": "Tile Map Service",
      "description": "TMS 1.0.0 tile service mirroring GeoWebCache, supporting both RESTful and KVP access."
    },
    "wmsc": {
      "fullName": "Cached WMS · WMS-C",
      "description": "Cached WMS tile service mirroring GeoWebCache, slicing maps on a fixed grid."
    },
    "mvt": {
      "fullName": "Vector Tiles · Mapbox Vector Tile",
      "description": "Vector feature tiles with .pbf suffix, suitable for highly scalable client-side rendering."
    }
  },
