# =============================================================================
# GeoFerris configuration template
# Copy this file to geoferris.toml and adjust it for your environment.
# Every option has a sensible default and can be overridden as needed.
#
# Configuration sources & precedence (highest first):
#   1. CLI flags:         --host, --port   (override [server] host/port)
#   2. Environment vars:  GEOSERVER__<SECTION>__<FIELD>  (double underscore)
#   3. Config file:       geoferris.toml   (path via --config, default "geoferris")
#
# Env var naming: prefix "GEOSERVER", sections and fields joined with "__".
#   GEOSERVER__SERVER__HOST                 -> [server] host
#   GEOSERVER__METADATA__POSTGRES__HOST     -> [metadata.postgres] host
#   GEOSERVER__VECTOR__KIND                 -> [vector] kind
#   GEOSERVER__RASTER__KIND                 -> [raster] kind
#   GEOSERVER__CACHE__KIND                  -> [cache] kind
# The special var RUST_LOG overrides [logging] level (see below).
#
# NOTE: if any REQUIRED key is missing (host / port / api_context /
# [[workspaces]] / cache.cache_dir / cache.meta_dir when [cache] is present), the
# whole config fails to load and the server silently falls back to built-in
# defaults (metadata kind reverts to "sqlite"). Keep required sections complete.
# =============================================================================

# ---------------------------------------------------------------------------
# Data directory (top-level key — must stay before any [section] header)
# Root directory for vector/raster data files (default: "./data")
# Env: GEOSERVER__DATA_DIR
# ---------------------------------------------------------------------------
data_dir = "./data"

# ---------------------------------------------------------------------------
# Server basics
# ---------------------------------------------------------------------------
[server]
# Bind address (REQUIRED; built-in default: "127.0.0.1")
# Env: GEOSERVER__SERVER__HOST | CLI: --host
host = "127.0.0.1"

# Listen port (REQUIRED; built-in default: 8080)
# Env: GEOSERVER__SERVER__PORT | CLI: --port
port = 8080

# REST API context path (REQUIRED; built-in default: "/geoserver")
# Env: GEOSERVER__SERVER__API_CONTEXT
api_context = "/geoserver"

# Static file directory holding the built Angular frontend (default: "./static")
# Env: GEOSERVER__SERVER__STATIC_DIR
static_dir = "./static"

# PostgreSQL connection timeout in seconds (default: 10)
# Env: GEOSERVER__SERVER__CONNECT_TIMEOUT_SECS
connect_timeout_secs = 10

# Graceful shutdown: seconds to wait for in-flight requests on SIGTERM/SIGINT
# before force-drop (default: 30; container/K8s rolling updates rely on this)
# Env: GEOSERVER__SERVER__SHUTDOWN_TIMEOUT_SECS
shutdown_timeout_secs = 30

# ---------------------------------------------------------------------------
# Metadata storage (REQUIRED; default: sqlite)
# Stores workspaces, data sources, layer definitions, styles, permissions, etc.
# Backward compatible: the legacy section name [database] is accepted as an alias.
# ---------------------------------------------------------------------------
[metadata]
# Storage backend: "sqlite" (default, local dev) | "postgres" (cluster deploy)
# Env: GEOSERVER__METADATA__KIND   (legacy: GEOSERVER__DATABASE__KIND)
kind = "sqlite"
# SQLite database file path (default: "geoserver.sqlite"; used only when kind = "sqlite")
# Env: GEOSERVER__METADATA__SQLITE_PATH
sqlite_path = "geoserver.sqlite"

# PostgreSQL connection config (used only when kind = "postgres").
# The whole section is optional; every field below has a default.
# Env overrides: GEOSERVER__METADATA__POSTGRES__HOST / __PORT / __INSTANCE
#                / __SCHEMA / __USER / __PASSWORD / __POOL_SIZE
[metadata.postgres]
host = "127.0.0.1"
port = 5432
instance = "geoserver"
schema = "public"
user = "postgres"
# Built-in default is an empty string ""; the value here is just an example.
password = "postgres"
# Connection pool size (default: 10)
pool_size = 10

# ---------------------------------------------------------------------------
# Vector data storage (OPTIONAL)
# Stores layer feature (vector) data, decoupled from metadata so each can
# scale/extend independently (e.g. metadata in PostgreSQL, vector data in
# another database / NFS / object storage).
# Backward compatible: the legacy section name [business] is accepted as an alias.
#
# Defaults when [vector] is omitted:
#   - metadata kind = sqlite   -> "local" (local directory, default <data_dir>/business)
#   - metadata kind = postgres -> "metadata" (reuse the metadata store, the
#                                 built-in default data source option)
# ---------------------------------------------------------------------------
[vector]
# Storage backend: "local" (local dir / NFS / object storage mount) |
#                  "metadata" (reuse metadata store) |
#                  "postgres" (standalone PostgreSQL)
# Env: GEOSERVER__VECTOR__KIND   (legacy: GEOSERVER__BUSINESS__KIND)
kind = "local"
# Local directory for vector data (kind = "local"; default: "<data_dir>/business")
# Each layer is stored as one GeoJSON FeatureCollection file (<dir>/<layer>.geojson).
# Env: GEOSERVER__VECTOR__DIR   (legacy: GEOSERVER__BUSINESS__DIR)
# dir = "./data/business"

# Standalone PostgreSQL config (used only when kind = "postgres").
# Env overrides: GEOSERVER__VECTOR__POSTGRES__HOST / __PORT / __INSTANCE
#                / __SCHEMA / __USER / __PASSWORD / __POOL_SIZE
[vector.postgres]
host = "127.0.0.1"
port = 5432
instance = "geoserver_vector"
schema = "public"
user = "postgres"
password = "postgres"
pool_size = 10

# ---------------------------------------------------------------------------
# Raster data storage (OPTIONAL)
# Stores raster files (GeoTIFF / WorldImage / ArcGrid). Decoupled from metadata
# so raster data can live on a shared volume / NFS / object storage later.
# Backends: "local" (default; local dir / NFS / object storage mount).
#           Future: "s3" / "minio" object storage.
#
# Defaults when [raster] is omitted: kind = "local", dir = <data_dir>/rasters
# ---------------------------------------------------------------------------
[raster]
# Storage backend: "local" (default)
# Env: GEOSERVER__RASTER__KIND
kind = "local"
# Local directory for raster files (kind = "local"; default: "<data_dir>/rasters")
# Env: GEOSERVER__RASTER__DIR
# dir = "./data/rasters"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
[security]
# JWT signing secret. In a multi-replica cluster every replica MUST share the
# same value. For production, inject it via the GEOSERVER__SECURITY__JWT_SECRET
# environment variable instead of committing it to a file.
# Built-in default: "geoferris-jwt-secret-2026"
jwt_secret = "geoferris-jwt-secret-2026"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
[logging]
# Log level: trace / debug / info / warn / error (default: "info")
# Env: GEOSERVER__LOGGING__LEVEL, or RUST_LOG (RUST_LOG takes precedence)
level = "info"

# ---------------------------------------------------------------------------
# Cache storage — tile cache + session cache (optional)
# Backward compatible: the legacy section name [gwc] is accepted as an alias.
# Backends: "local" (default; tile cache on disk, session cache in memory).
#           Future: "redis".
# ---------------------------------------------------------------------------
[cache]
# Cache backend: "local" (default)
# Env: GEOSERVER__CACHE__KIND
kind = "local"
# Tile cache root directory (REQUIRED when this section is present;
# built-in default: "<data_dir>/gwc")
# Env: GEOSERVER__CACHE__CACHE_DIR   (legacy: GEOSERVER__GWC__CACHE_DIR)
cache_dir = "./data/gwc"
# Tile cache metadata directory (REQUIRED when this section is present;
# built-in default: "<data_dir>/gwc/meta")
# Env: GEOSERVER__CACHE__META_DIR   (legacy: GEOSERVER__GWC__META_DIR)
meta_dir = "./data/gwc/meta"
# Tile expiration time in seconds (0 = never expire; default: 86400 = 24h)
# Env: GEOSERVER__CACHE__EXPIRE_AFTER_SECS
expire_after_secs = 86400
# Max cached tiles (0 = unlimited). When omitted in the file the default is 0;
# the built-in fallback default is 100000.
# Env: GEOSERVER__CACHE__MAX_TILES
max_tiles = 100000
# Enable tile cache (default: true)
# Env: GEOSERVER__CACHE__ENABLED
enabled = true
# Default Gridset (default: "EPSG:4326")
# Env: GEOSERVER__CACHE__DEFAULT_GRIDSET
default_gridset = "EPSG:4326"
# Session cache TTL in seconds (local in-memory session cache; default: 86400)
# Env: GEOSERVER__CACHE__SESSION_TTL_SECS
session_ttl_secs = 86400

# ---------------------------------------------------------------------------
# CORS config (optional)
# ---------------------------------------------------------------------------
[cors]
# Enable CORS (default: true)
# Env: GEOSERVER__CORS__ENABLED
enabled = true
# Allowed origins ("*" = allow all; default: ["*"])
# Env: GEOSERVER__CORS__ALLOWED_ORIGINS
allowed_origins = ["*"]
# Allowed HTTP methods (default: GET, POST, PUT, DELETE, OPTIONS, PATCH)
# Env: GEOSERVER__CORS__ALLOWED_METHODS
allowed_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
# Allowed request headers (default: ["*"])
# Env: GEOSERVER__CORS__ALLOWED_HEADERS
allowed_headers = ["*"]
# Allow credentials (default: true)
# Env: GEOSERVER__CORS__ALLOW_CREDENTIALS
allow_credentials = true
# Preflight request cache time in seconds (default: 3600)
# Env: GEOSERVER__CORS__MAX_AGE
max_age = 3600

# ---------------------------------------------------------------------------
# Workspace config (multiple [[workspaces]] entries are allowed)
# NOTE: this is a REQUIRED top-level section; arrays are not meant to be
# overridden via environment variables.
# ---------------------------------------------------------------------------
[[workspaces]]
name = "default"
uri = "http://geoserver.org/default"

[[workspaces.stores]]
name = "shapes"
store_type = "DataStore"
path = "./data/shapefiles"

[[workspaces.stores.layers]]
name = "countries"
title = "World Countries"
abstract = "World countries boundaries"
srs = "EPSG:4326"
# Optional: default style name
# style = "population"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0

[[workspaces.stores.layers]]
name = "cities"
title = "Major Cities"
abstract = "World major cities"
srs = "EPSG:4326"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0
