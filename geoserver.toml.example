# =============================================================================
# Rust GeoServer configuration template
# Copy this file to geoserver.toml and adjust it for your environment.
# Every option has a sensible default and can be overridden as needed.
#
# Configuration sources & precedence (highest first):
#   1. CLI flags:         --host, --port   (override [server] host/port)
#   2. Environment vars:  GEOSERVER__<SECTION>__<FIELD>  (double underscore)
#   3. Config file:       geoserver.toml   (path via --config, default "geoserver")
#
# Env var naming: prefix "GEOSERVER", sections and fields joined with "__".
#   GEOSERVER__SERVER__HOST                 -> [server] host
#   GEOSERVER__DATABASE__POSTGRES__HOST     -> [database.postgres] host
# The special var RUST_LOG overrides [logging] level (see below).
#
# NOTE: if any REQUIRED key is missing (host / port / api_context /
# [[workspaces]] / gwc.cache_dir / gwc.meta_dir when [gwc] is present), the
# whole config fails to load and the server silently falls back to built-in
# defaults (database kind reverts to "sqlite"). Keep required sections complete.
# =============================================================================

# ---------------------------------------------------------------------------
# Server basics
# ---------------------------------------------------------------------------
[server]
# Bind address (REQUIRED; built-in default: "127.0.0.1")
# Env: GEOSERVER__SERVER__HOST | CLI: --host
host = "127.0.0.1"

# Listen port (REQUIRED; built-in default: 8080)
# Env: GEOSERVER__SERVER__PORT | CLI: --port
port = 8080

# REST API context path (REQUIRED; built-in default: "/geoserver")
# Env: GEOSERVER__SERVER__API_CONTEXT
api_context = "/geoserver"

# Static file directory holding the built Angular frontend (default: "./static")
# Env: GEOSERVER__SERVER__STATIC_DIR
static_dir = "./static"

# PostgreSQL connection timeout in seconds (default: 10)
# Env: GEOSERVER__SERVER__CONNECT_TIMEOUT_SECS
connect_timeout_secs = 10

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
[database]
# Storage backend: "sqlite" (default, local dev) | "postgres" (cluster deploy)
# Env: GEOSERVER__DATABASE__KIND
kind = "sqlite"
# SQLite database file path (default: "geoserver.sqlite"; used only when kind = "sqlite")
# Env: GEOSERVER__DATABASE__SQLITE_PATH
sqlite_path = "geoserver.sqlite"

# PostgreSQL connection config (used only when kind = "postgres").
# The whole section is optional; every field below has a default.
# Env overrides: GEOSERVER__DATABASE__POSTGRES__HOST / __PORT / __NAME
#                / __USER / __PASSWORD / __POOL_SIZE
[database.postgres]
host = "127.0.0.1"
port = 5432
name = "geoserver"
user = "postgres"
# Built-in default is an empty string ""; the value here is just an example.
password = "postgres"
# Connection pool size (default: 10)
pool_size = 10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
[security]
# JWT signing secret. In a multi-replica cluster every replica MUST share the
# same value. For production, inject it via the GEOSERVER__SECURITY__JWT_SECRET
# environment variable instead of committing it to a file.
# Built-in default: "rust-geoserver-jwt-secret-2026"
jwt_secret = "rust-geoserver-jwt-secret-2026"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
[logging]
# Log level: trace / debug / info / warn / error (default: "info")
# Env: GEOSERVER__LOGGING__LEVEL, or RUST_LOG (RUST_LOG takes precedence)
level = "info"

# ---------------------------------------------------------------------------
# GeoWebCache tile cache config (optional)
# ---------------------------------------------------------------------------
[gwc]
# Tile cache root directory (REQUIRED when this section is present;
# built-in default: "<data_dir>/gwc")
# Env: GEOSERVER__GWC__CACHE_DIR
cache_dir = "./data/gwc"
# Cache metadata directory (REQUIRED when this section is present;
# built-in default: "<data_dir>/gwc/meta")
# Env: GEOSERVER__GWC__META_DIR
meta_dir = "./data/gwc/meta"
# Tile expiration time in seconds (0 = never expire; default: 86400 = 24h)
# Env: GEOSERVER__GWC__EXPIRE_AFTER_SECS
expire_after_secs = 86400
# Max cached tiles (0 = unlimited). When omitted in the file the default is 0;
# the built-in fallback default is 100000.
# Env: GEOSERVER__GWC__MAX_TILES
max_tiles = 100000
# Enable disk cache (default: true)
# Env: GEOSERVER__GWC__ENABLED
enabled = true
# Default Gridset (default: "EPSG:4326")
# Env: GEOSERVER__GWC__DEFAULT_GRIDSET
default_gridset = "EPSG:4326"

# ---------------------------------------------------------------------------
# Data directory
# Root directory for vector/raster data files (default: "./data")
# Env: GEOSERVER__DATA_DIR
# ---------------------------------------------------------------------------
data_dir = "./data"

# ---------------------------------------------------------------------------
# CORS config (optional)
# ---------------------------------------------------------------------------
[cors]
# Enable CORS (default: true)
# Env: GEOSERVER__CORS__ENABLED
enabled = true
# Allowed origins ("*" = allow all; default: ["*"])
# Env: GEOSERVER__CORS__ALLOWED_ORIGINS
allowed_origins = ["*"]
# Allowed HTTP methods (default: GET, POST, PUT, DELETE, OPTIONS, PATCH)
# Env: GEOSERVER__CORS__ALLOWED_METHODS
allowed_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
# Allowed request headers (default: ["*"])
# Env: GEOSERVER__CORS__ALLOWED_HEADERS
allowed_headers = ["*"]
# Allow credentials (default: true)
# Env: GEOSERVER__CORS__ALLOW_CREDENTIALS
allow_credentials = true
# Preflight request cache time in seconds (default: 3600)
# Env: GEOSERVER__CORS__MAX_AGE
max_age = 3600

# ---------------------------------------------------------------------------
# Workspace config (multiple [[workspaces]] entries are allowed)
# NOTE: this is a REQUIRED top-level section; arrays are not meant to be
# overridden via environment variables.
# ---------------------------------------------------------------------------
[[workspaces]]
name = "default"
uri = "http://geoserver.org/default"

[[workspaces.stores]]
name = "shapes"
store_type = "DataStore"
path = "./data/shapefiles"

[[workspaces.stores.layers]]
name = "countries"
title = "World Countries"
abstract = "World countries boundaries"
srs = "EPSG:4326"
# Optional: default style name
# style = "population"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0

[[workspaces.stores.layers]]
name = "cities"
title = "Major Cities"
abstract = "World major cities"
srs = "EPSG:4326"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0
