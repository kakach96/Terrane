# =============================================================================
# Rust GeoServer 配置模板
# 复制此文件为 geoserver.toml 并根据实际环境修改
# 所有配置项均有合理的默认值，可按需覆盖
# =============================================================================

# ---------------------------------------------------------------------------
# 服务器基础配置
# ---------------------------------------------------------------------------
[server]
# 监听地址 (默认: "127.0.0.1")
host = "127.0.0.1"

# 监听端口 (默认: 8080)
port = 8080

# REST API 上下文路径 (默认: "/geoserver")
api_context = "/geoserver"

# 静态文件目录，存放前端 Angular 构建产物 (默认: "./static")
static_dir = "./static"

# PostgreSQL 连接超时秒数 (默认: 10)
connect_timeout_secs = 10

# ---------------------------------------------------------------------------
# 数据库配置
# ---------------------------------------------------------------------------
[database]
# 存储后端类型: "sqlite" (默认, 本地开发) | "postgres" (集群部署)
kind = "sqlite"
# SQLite 数据库文件路径 (默认: "geoserver.sqlite", 仅 kind = "sqlite" 时生效)
sqlite_path = "geoserver.sqlite"

# PostgreSQL 连接配置 (仅 kind = "postgres" 时生效)
# 可通过环境变量 GEOSERVER__DATABASE__POSTGRES__HOST 等覆盖
[database.postgres]
host = "127.0.0.1"
port = 5432
name = "geoserver"
user = "postgres"
password = "postgres"
# 连接池大小
pool_size = 10

# ---------------------------------------------------------------------------
# 安全配置
# ---------------------------------------------------------------------------
[security]
# JWT 签名密钥。集群多副本部署时必须配置为相同值。
# 生产环境建议通过环境变量 GEOSERVER__SECURITY__JWT_SECRET 注入。
jwt_secret = "rust-geoserver-jwt-secret-2026"

# ---------------------------------------------------------------------------
# 日志配置
# ---------------------------------------------------------------------------
[logging]
# 日志级别: trace / debug / info / warn / error (默认: "info")
# 可通过环境变量 RUST_LOG 覆盖此设置
level = "info"

# ---------------------------------------------------------------------------
# GeoWebCache 瓦片缓存配置 (可选)
# ---------------------------------------------------------------------------
[gwc]
# 瓦片缓存根目录 (默认: "<data_dir>/gwc")
cache_dir = "./data/gwc"
# 缓存元数据目录
meta_dir = "./data/gwc/meta"
# 瓦片过期时间 (秒, 0=永不过期, 默认: 86400=24h)
expire_after_secs = 86400
# 最大缓存瓦片数 (0=无限制, 默认: 100000)
max_tiles = 100000
# 是否启用磁盘缓存 (默认: true)
enabled = true
# 默认 Gridset (默认: "EPSG:4326")
default_gridset = "EPSG:4326"

# ---------------------------------------------------------------------------
# 数据目录
# 矢量/栅格数据文件的存放目录 (默认: "./data")
# ---------------------------------------------------------------------------
data_dir = "./data"

# ---------------------------------------------------------------------------
# CORS 跨域配置 (可选)
# ---------------------------------------------------------------------------
[cors]
# 是否启用 CORS (默认: true)
enabled = true
# 允许的来源 ("*" = 允许所有, 默认: ["*"])
allowed_origins = ["*"]
# 允许的 HTTP 方法 (默认: GET, POST, PUT, DELETE, OPTIONS, PATCH)
allowed_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
# 允许的请求头 (默认: ["*"])
allowed_headers = ["*"]
# 是否允许携带凭据 (默认: true)
allow_credentials = true
# 预检请求缓存时间 (秒, 默认: 3600)
max_age = 3600

# ---------------------------------------------------------------------------
# 工作空间配置 (可配置多个 [[workspaces]])
# ---------------------------------------------------------------------------
[[workspaces]]
name = "default"
uri = "http://geoserver.org/default"

[[workspaces.stores]]
name = "shapes"
store_type = "DataStore"
path = "./data/shapefiles"

[[workspaces.stores.layers]]
name = "countries"
title = "World Countries"
abstract = "World countries boundaries"
srs = "EPSG:4326"
# 可选: 默认样式名称
# style = "population"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0

[[workspaces.stores.layers]]
name = "cities"
title = "Major Cities"
abstract = "World major cities"
srs = "EPSG:4326"

[workspaces.stores.layers.bounds]
minx = -180.0
miny = -90.0
maxx = 180.0
maxy = 90.0
